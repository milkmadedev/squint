<Window x:Class="Squint.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Squint — settings"
        Width="600" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1B1E24"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Background" Value="#0F1216" />
            <Setter Property="Foreground" Value="#E8ECF2" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="CaretBrush" Value="#E8ECF2" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,20,0,0" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#AFB7C4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>

                <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,0">How a verdict is decided</TextBlock>
                <TextBlock Style="{StaticResource Note}">
                    <Run Text="SUSPECT" Foreground="#EF4444" FontWeight="Bold" /> — any source flags it.
                    <LineBreak />
                    <Run Text="VERIFIED" Foreground="#22C55E" FontWeight="Bold" /> — the destination is on the
                    known-good list and nothing flagged it.
                    <LineBreak />
                    <Run Text="CAUTION" Foreground="#F59E0B" FontWeight="Bold" /> — everything else. These are
                    blocklists, so "not listed" never means safe.
                </TextBlock>

                <TextBlock Style="{StaticResource Heading}">Google Safe Browsing</TextBlock>
                <TextBlock Style="{StaticResource Note}">
                    Free, 10,000 lookups/day. console.cloud.google.com → create a project → enable the
                    Safe Browsing API → Credentials → API key.
                </TextBlock>
                <TextBox x:Name="GsbBox" />

                <TextBlock Style="{StaticResource Heading}">VirusTotal</TextBlock>
                <TextBlock Style="{StaticResource Note}">
                    Around 90 engines. Free tier is personal, non-commercial use — 4 lookups/min, 500/day.
                    virustotal.com → sign in → profile menu → API key.
                </TextBlock>
                <TextBox x:Name="VtBox" />

                <TextBlock Style="{StaticResource Heading}">URLhaus (abuse.ch)</TextBlock>
                <TextBlock Style="{StaticResource Note}">
                    A live feed of URLs actively serving malware — often lists a payload within minutes,
                    long before Google does. Free Auth-Key from auth.abuse.ch.
                </TextBlock>
                <TextBox x:Name="HausBox" />

                <TextBlock Style="{StaticResource Heading}">Your own trusted domains</TextBlock>
                <TextBlock Style="{StaticResource Note}">
                    One per line, added to the built-in known-good list. Subdomains are included.
                    Don't add anything that hosts other people's uploads.
                </TextBlock>
                <TextBox x:Name="TrustedBox" Height="76" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />

                <CheckBox x:Name="FollowRedirectsBox" Margin="0,20,0,0" Foreground="#E8ECF2" FontSize="12.5"
                          Content="Follow redirects before scanning (recommended)" />
                <TextBlock Style="{StaticResource Note}" Margin="24,4,0,0" Foreground="#6E7887">
                    Resolves shorteners so the real destination is what gets judged. Contacting the server
                    tells it the link was received; headers only, no page content is downloaded.
                </TextBlock>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="StatusText" Foreground="#F59E0B" FontSize="11.5" Margin="0,14,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="TestButton" Content="Test keys" Width="104" Height="30" Margin="0,0,8,0"
                        Click="OnTest" />
                <Button Content="Save" Width="96" Height="30" IsDefault="True" Click="OnSave" />
                <Button Content="Cancel" Width="96" Height="30" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
