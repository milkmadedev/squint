<Window x:Class="Squint.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Squint"
        Width="404" Height="146"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Fixed Width/Height above and fixed row heights below keep every toast identical,
         whatever the verdict text happens to be. -->
    <Border x:Name="Card" Margin="14" Padding="16,14" CornerRadius="12"
            Background="#F5191C22" BorderThickness="1" BorderBrush="#2EFFFFFF">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Status icon with its label directly underneath -->
            <StackPanel Grid.Column="0" Width="62" VerticalAlignment="Center">
                <Image x:Name="IconImage" Width="44" Height="44" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="StatusLabel" Text="PROCESSING" Height="12"
                           FontSize="9" FontWeight="Bold" Foreground="#E8ECF2"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HostText" Height="20"
                           FontSize="14.5" FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" />
                <!-- Height is exactly three lines at this font size; longer text clips rather
                     than resizing the toast. -->
                <TextBlock x:Name="DetailText" Height="46" Margin="0,4,0,0"
                           FontSize="11.5" LineHeight="15.3" LineStackingStrategy="BlockLineHeight"
                           Foreground="#AFB7C4" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="UrlText" Height="14" Margin="0,3,0,0"
                           FontSize="10.5" Foreground="#6E7887"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
